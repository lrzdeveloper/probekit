{
  "name": "@lrzdeveloper/probekit",
  "version": "0.1.3",
  "description": "Installs the probekit app security skill and the REA MCP server (Ghidra, JADX, apktool) into your AI agents, such as Claude Code, Codex, Cursor and Gemini CLI. It detects the agents on your machine and lets you pick which ones to set up.",
  "type": "module",
  "bin": {
    "probekit": "bin/cli.mjs"
  },
  "files": [
    "bin/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "keywords": [
    "security",
    "reverse-engineering",
    "malware-analysis",
    "ghidra",
    "jadx",
    "mitmproxy",
    "claude-code",
    "mcp",
    "skill"
  ],
  "author": "lrzdeveloper",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lrzdeveloper/probekit.git"
  },
  "bugs": {
    "url": "https://github.com/lrzdeveloper/probekit/issues"
  },
  "homepage": "https://github.com/lrzdeveloper/probekit#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "doctor": "node bin/cli.mjs doctor",
    "test": "node --test"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.9.1"
  }
}
